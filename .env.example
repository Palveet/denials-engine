# Required. Runtime decisions always use the configured provider; there is no
# fixture or dummy-decision mode.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
# Exact model ID; change this without changing application code.
LLM_MODEL=claude-sonnet-5
DATABASE_URL=sqlite:///./denials.db
MAX_UPLOAD_BYTES=5000000
